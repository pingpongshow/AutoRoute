      (place U9 17000 -11000 front 270 (PN X))
      (place U10 23000 -11000 front 0 (PN X))
      (place U11 29000 -11000 front 0 (PN X))
      (place U12 35000 -11000 front 0 (PN X))
      (place U13 5000 -17000 front 90 (PN X))
      (place U14 11000 -17000 front 90 (PN X))
      (place U15 17000 -17000 front 0 (PN X))
      (place U16 23000 -17000 front 90 (PN X))
      (place U17 29000 -17000 front 270 (PN X))
      (place U18 35000 -17000 front 90 (PN X))
      (place U19 5000 -23000 front 270 (PN X))
