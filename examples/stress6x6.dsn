      (place U22 23000 -23000 front 90 (PN X))
      (place U23 29000 -23000 front 270 (PN X))
      (place U24 35000 -23000 front 180 (PN X))
      (place U25 5000 -29000 front 180 (PN X))
      (place U26 11000 -29000 front 90 (PN X))
      (place U27 17000 -29000 front 90 (PN X))
      (place U28 23000 -29000 front 180 (PN X))
      (place U29 29000 -29000 front 0 (PN X))
      (place U30 35000 -29000 front 0 (PN X))
      (place U31 5000 -35000 front 270 (PN X))
      (place U32 11000 -35000 front 0 (PN X))
      (place U33 17000 -35000 front 180 (PN X))
      (place U34 23000 -35000 front 180 (PN X))
      (place U35 29000 -35000 front 180 (PN X))
      (place U36 35000 -35000 front 0 (PN X))
    )
  )
  (library
    (image "R_0805"
      (pin RoundRect[T]Pad_1025x1400_um 1 -937.5 0)
      (pin RoundRect[T]Pad_1025x1400_um 2 937.5 0)
    )
    (padstack RoundRect[T]Pad_1025x1400_um
      (shape (rect F.Cu -512.5 -700 512.5 700))
      (attach off)
    )
    (padstack "Via[0-1]_800:400_um"
      (shape (circle F.Cu 800 0 0))
      (shape (circle B.Cu 800 0 0))
      (attach off)
    )
  )
  (network
    (net "N1" (pins U1-2 U19-1))
    (net "N2" (pins U2-2 U21-1))
    (net "N3" (pins U3-2 U23-1))
    (net "N4" (pins U4-2 U22-1))
    (net "N5" (pins U5-2 U24-1))
    (net "N6" (pins U6-2 U26-1))
    (net "N7" (pins U7-2 U25-1))
